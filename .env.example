# Copy to .env and adjust. The server reads this file from the repository root.

# --- server ----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Signs the session cookie. MUST be set to a long random value in production;
# the server refuses to start in production without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# Postgres. In production use the provider's *pooled* connection string —
# a serverless deployment runs many short-lived instances, and a direct
# connection per instance is how a connection limit gets exhausted. Managed
# providers hand you a URL that already carries `?sslmode=require`.
DATABASE_URL=postgres://shoresh@localhost:5432/shoresh

# Where uploaded originals go.
#   disk — a local directory. The default in development; needs no account.
#   blob — Vercel Blob. The default in production, because a serverless
#          filesystem does not survive the request that wrote to it.
STORAGE_DRIVER=disk

# Required when STORAGE_DRIVER=blob. Vercel injects this automatically once a
# Blob store is connected to the project; set it by hand only for a local test.
BLOB_READ_WRITE_TOKEN=

# Only used by the disk driver. Relative paths resolve against the server
# package directory.
DATA_DIR=./data

# Who may use the archive.
#   open   — anyone with the link reads and contributes. No joining, no code,
#            no roles. The default: an archive still being built should not
#            cost its author a login to look at. INVITE_CODE and PUBLIC_READ
#            below are ignored, and /api/health says so.
#   invite — the full arrangement, with everything below in force.
ACCESS=open

# Invite mode only. Leave blank to let anyone join; set it to gate joining
# behind a code you share privately with relatives.
INVITE_CODE=

# Invite mode only. When true, visitors without a session can read the tree and
# archive but cannot write. Set to false to require joining before any read.
PUBLIC_READ=true

# Comma-separated list of browser origins allowed to call the API with
# credentials. The Vite dev server is included by default in development.
CORS_ORIGINS=http://localhost:5173

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=25

# --- client ----------------------------------------------------------------
# Base URL the browser uses for API calls. Leave blank to use same-origin
# requests, which is correct in production where the server also serves the
# built client. In development Vite proxies /api to PORT above.
VITE_API_BASE_URL=
